        {
          "name": "12. Gate Double-Exit Validation Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test('Rejection confirms no active parking session found', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.be.false;",
                  "    pm.expect(res.message).to.include('No active parking session');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
