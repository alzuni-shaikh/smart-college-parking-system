          "name": "3. Backend Health Check Endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Service status is ok', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.status).to.eql('ok');",
                  "    pm.expect(res.service).to.eql('Smart College Parking Backend');",
                  "});",
                  "pm.test('Timestamp is valid ISO date', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(new Date(res.timestamp).getTime()).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/api/health",
              "host": ["{{apiUrl}}"],
              "path": ["api", "health"]
            }
          }
