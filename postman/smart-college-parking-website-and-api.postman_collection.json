      "name": "🌐 Website Tests",
      "item": [
        {
          "name": "1. Website Live Production Homepage",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is HTML document', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');",
                  "});",
                  "pm.test('Page contains root mount element <div id=\"root\">', function () {",
                  "    pm.expect(pm.response.text()).to.include('id=\"root\"');",
                  "});",
                  "pm.test('Page title is SOCMAC Smart Park', function () {",
                  "    pm.expect(pm.response.text()).to.include('<title>SOCMAC Smart Park | Intelligent Campus System</title>');",
                  "});",
                  "pm.test('Verify script bundle tag exists in HTML', function () {",
                  "    pm.expect(pm.response.text()).to.include('<script type=\"module\"');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{webUrl}}/",
              "host": ["{{webUrl}}"],
              "path": [""]
            }
          }
        },
