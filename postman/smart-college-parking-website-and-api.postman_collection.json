        {
          "name": "9. Gate Ingress: Verify & Enter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Access granted with dynamic bay assignment on Ground Floor for Scooty', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.status).to.eql('ACCESS_GRANTED');",
                  "    pm.expect(res.slotId).to.match(/^G-\\d{2}$/);",
                  "    pm.expect(res.floor).to.eql('Ground Floor');",
                  "    pm.collectionVariables.set('assignedSlotId', res.slotId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrToken\": \"{{qrToken}}\",\n  \"plate\": \"MH12AB9999\",\n  \"studentName\": \"Postman Integration Tester\",\n  \"vehicleType\": \"scooty\"\n}"
            },
            "url": {
              "raw": "{{apiUrl}}/api/gate/verify-and-enter",
              "host": ["{{apiUrl}}"],
              "path": ["api", "gate", "verify-and-enter"]
            }
          }
        },
        {
          "name": "10. Gate Anti-Passback Violation Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test('Anti-passback rejection code is ALREADY_PARKED', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.be.false;",
                  "    pm.expect(res.code).to.eql('ALREADY_PARKED');",
                  "    pm.expect(res.status).to.eql('ACCESS_DENIED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrToken\": \"{{qrToken}}\",\n  \"plate\": \"MH12AB9999\",\n  \"studentName\": \"Postman Integration Tester\",\n  \"vehicleType\": \"scooty\"\n}"
            },
            "url": {
              "raw": "{{apiUrl}}/api/gate/verify-and-enter",
              "host": ["{{apiUrl}}"],
              "path": ["api", "gate", "verify-and-enter"]
            }
          }
        },
        {
          "name": "11. Gate Egress: Checkout & Release Bay",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Vehicle checked out, bay released, duration formatted in history', function () {",
                  "    const res = pm.response.json();",
