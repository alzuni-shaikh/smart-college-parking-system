        {
          "name": "4. Parking State & Capacity (160 Bays)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Total bays exactly 160 (80 Ground Scooty + 80 Basement Bike)', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.stats.total).to.eql(160);",
                  "    pm.expect(res.stats.ground.total).to.eql(80);",
                  "    pm.expect(res.stats.basement.total).to.eql(80);",
                  "    pm.expect(res.slots.length).to.eql(160);",
                  "});",
                  "pm.test('Active sessions array and history exist', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.activeSessions).to.be.an('array');",
                  "    pm.expect(res.history).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/api/parking/state",
              "host": ["{{apiUrl}}"],
              "path": ["api", "parking", "state"]
            }
          }
        },
        {
          "name": "5. Parking Slots Directory",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Slots array contains 160 elements', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res).to.be.an('array').with.lengthOf(160);",
                  "});",
                  "pm.test('Canonical bay IDs verified (G-01, G-80, B-01, B-80)', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res[0].id).to.eql('G-01');",
                  "    pm.expect(res[79].id).to.eql('G-80');",
                  "    pm.expect(res[80].id).to.eql('B-01');",
                  "    pm.expect(res[159].id).to.eql('B-80');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/api/parking/slots",
              "host": ["{{apiUrl}}"],
              "path": ["api", "parking", "slots"]
            }
          }
        },
        {
          "name": "6. Create Permit Checkout Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Permit session created with PENDING_PAYMENT status', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.permitId).to.be.a('string');",
                  "    pm.expect(res.permit.status).to.eql('PENDING_PAYMENT');",
                  "    pm.expect(res.permit.paymentStatus).to.eql('UNPAID');",
                  "    pm.collectionVariables.set('permitId', res.permitId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"STU-990\",\n  \"studentName\": \"Postman Integration Tester\",\n  \"rollNumber\": \"ROLL-888\",\n  \"vehiclePlate\": \"MH12AB9999\",\n  \"vehicleType\": \"scooty\",\n  \"permitType\": \"Daily\"\n}"
            },
