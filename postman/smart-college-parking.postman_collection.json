  "item": [
    {
      "name": "1. Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Service status is ok', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('ok');",
              "    pm.expect(jsonData.service).to.eql('Smart College Parking Backend');",
              "});",
              "pm.test('Response contains valid ISO timestamp', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.timestamp).to.be.a('string');",
              "    pm.expect(new Date(jsonData.timestamp).getTime()).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "2. Get System & Parking State",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Capacity totals match exactly 160 slots (80 Ground + 80 Basement)', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.stats.total).to.eql(160);",
              "    pm.expect(jsonData.stats.ground.total).to.eql(80);",
              "    pm.expect(jsonData.stats.basement.total).to.eql(80);",
              "    pm.expect(jsonData.slots.length).to.eql(160);",
              "});",
              "pm.test('Active sessions and history arrays exist', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.activeSessions).to.be.an('array');",
              "    pm.expect(jsonData.history).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/parking/state",
          "host": ["{{baseUrl}}"],
          "path": ["api", "parking", "state"]
        }
      }
    },
    {
      "name": "3. Get Parking Slots Array",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returned slots array has 160 entries', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array').with.lengthOf(160);",
              "});",
              "pm.test('First slot is G-01 and last Ground slot is G-80', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData[0].id).to.eql('G-01');",
              "    pm.expect(jsonData[79].id).to.eql('G-80');",
              "    pm.expect(jsonData[80].id).to.eql('B-01');",
              "    pm.expect(jsonData[159].id).to.eql('B-80');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/parking/slots",
          "host": ["{{baseUrl}}"],
          "path": ["api", "parking", "slots"]
        }
      }
    },
    {
      "name": "4. Create Permit Checkout Session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Permit session created with PENDING_PAYMENT status', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.permitId).to.be.a('string');",
              "    pm.expect(jsonData.permit.status).to.eql('PENDING_PAYMENT');",
              "    pm.expect(jsonData.permit.paymentStatus).to.eql('UNPAID');",
              "    pm.collectionVariables.set('permitId', jsonData.permitId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
