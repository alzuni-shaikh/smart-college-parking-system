        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": \"STU-101\",\n  \"studentName\": \"Postman Test Runner\",\n  \"rollNumber\": \"ROLL-909\",\n  \"vehiclePlate\": \"MH12AB9999\",\n  \"vehicleType\": \"scooty\",\n  \"permitType\": \"Daily\"\n}"
        },
