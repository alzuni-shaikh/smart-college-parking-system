    {
      "name": "7. Gate Ingress: Verify & Enter",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Access granted with dynamic bay assignment on Ground Floor for Scooty', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.status).to.eql('ACCESS_GRANTED');",
              "    pm.expect(jsonData.slotId).to.match(/^G-\\d{2}$/);",
              "    pm.expect(jsonData.floor).to.eql('Ground Floor');",
              "    pm.collectionVariables.set('assignedSlotId', jsonData.slotId);",
              "});"
            ]
          }
        }
